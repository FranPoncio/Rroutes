/// Reportes de avance por paquete y fecha de corte. Solo el corte más reciente sale del fixture de PMTool; los anteriores los sintetiza scripts/build-powerbi-data.mjs.
table Avances

	/// Identificador del reporte de avance.
	column id
		dataType: string
		summarizeBy: none
		sourceColumn: id

		annotation SummarizationSetBy = Automatic

	/// Paquete de trabajo al que corresponde el avance.
	column workPackageId
		dataType: string
		summarizeBy: none
		sourceColumn: workPackageId

		annotation SummarizationSetBy = Automatic

	/// Fecha de corte del reporte (data date).
	column fechaCorte
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: fechaCorte

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Avance físico acumulado del paquete, en 0..1.
	column avanceFisico
		dataType: double
		summarizeBy: none
		sourceColumn: avanceFisico

		annotation SummarizationSetBy = Automatic

	/// Costo real acumulado (ACWP) del paquete a la fecha.
	column costoRealAcum
		dataType: double
		summarizeBy: none
		sourceColumn: costoRealAcum

		annotation SummarizationSetBy = Automatic

	partition Avances = m
		mode: import
		source =
				let
					Origen = #table(
						type table [id = text, workPackageId = text, fechaCorte = date, avanceFisico = number, costoRealAcum = number],
						{
						{"wp-ing-2025-09-30", "wp-ing", #date(2025, 9, 30), 0.0515, 73100},
						{"wp-ing-2025-10-31", "wp-ing", #date(2025, 10, 31), 0.1966, 228338},
