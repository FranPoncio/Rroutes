/// Paquetes de trabajo (WBS) con su presupuesto y sus fechas de baseline.
table Paquetes

	/// Identificador del paquete de trabajo.
	column id
		dataType: string
		summarizeBy: none
		sourceColumn: id

		annotation SummarizationSetBy = Automatic

	/// Nombre del paquete de trabajo.
	column nombre
		dataType: string
		summarizeBy: none
		sourceColumn: nombre

		annotation SummarizationSetBy = Automatic

	/// Presupuesto del paquete (parte del BAC).
	column presupuesto
		dataType: double
		summarizeBy: none
		sourceColumn: presupuesto

		annotation SummarizationSetBy = Automatic

	/// Peso relativo del paquete dentro del proyecto.
	column peso
		dataType: double
		summarizeBy: none
		sourceColumn: peso

		annotation SummarizationSetBy = Automatic

	/// Inicio planificado (baseline).
	column fechaInicioPlan
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: fechaInicioPlan

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Fin planificado (baseline).
	column fechaFinPlan
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: fechaFinPlan

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Responsable del paquete.
	column responsable
		dataType: string
		summarizeBy: none
		sourceColumn: responsable

		annotation SummarizationSetBy = Automatic

	partition Paquetes = m
		mode: import
		source =
				let
					Origen = #table(
						type table [id = text, nombre = text, presupuesto = number, peso = number, fechaInicioPlan = date, fechaFinPlan = date, responsable = text],
						{
						{"wp-ing", "Ingeniería de detalle", 850000, 3.7, #date(2025, 9, 1), #date(2026, 3, 31), "M. Alcaraz"},
						{"wp-adq", "Adquisición de cañería y válvulas", 4200000, 18.1, #date(2025, 11, 1), #date(2026, 9, 30), "S. Duarte"},
						{"wp-civ", "Obras civiles planta compresora", 3100000, 13.4, #date(2026, 1, 15), #date(2026, 12, 15), "R. Ibáñez"},
						{"wp-duc", "Tendido y soldadura de ducto", 6800000, 29.3, #date(2026, 3, 1), #date(2026, 12, 31), "J. Molina"},
						{"wp-mon", "Montaje electromecánico", 5400000, 23.3, #date(2026, 5, 1), #date(2027, 1, 31), "L. Ferreyra"},
						{"wp-scada", "Instrumentación y SCADA", 1650000, 7.1, #date(2026, 8, 1), #date(2027, 2, 28), "P. Sosa"},
						{"wp-pru", "Pruebas, precomisionado y habilitación", 1200000, 5.2, #date(2026, 11, 1), #date(2027, 3, 31), "C. Vega"}
						}
					)
				in
					Origen

	annotation PBI_ResultType = Table
